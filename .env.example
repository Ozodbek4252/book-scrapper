APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Public hostname the production stack (compose.prod.yaml) gets its
# Let's Encrypt certificate for. Unused outside that stack.
APP_DOMAIN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# "mysql" is the Compose service name. Use 127.0.0.1 when you run the app
# outside Docker; the container publishes the port to the host.
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=book_scraper
DB_USERNAME=book_scraper
DB_PASSWORD=secret
# Only used to create the database in the local MySQL container.
DB_ROOT_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must be larger than the longest job, or a slow job is retried while
# it is still running. Catalogue discovery can take ten minutes.
DB_QUEUE_RETRY_AFTER=2000

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Per-source kill switch. Turn a source off instantly without a deploy.
# Pages one run crawls. 0 means the whole catalogue (asaxiy: ~10,400, ~6 hours).
SCRAPING_MAX_PAGES_PER_RUN=500
SCRAPING_ASAXIY_ENABLED=true
# olcha has no ISBNs; it only enriches books already known. Run it after asaxiy.
SCRAPING_OLCHA_ENABLED=false

SCOUT_DRIVER=meilisearch
# Index in a queued job so a search outage can never fail a scrape upsert.
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKeyForLocalDevelopmentOnly
